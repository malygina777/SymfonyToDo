<nav class="navbar nav-glass navbar-expand-md shadow-sm"
     aria-label="Navigation principale">
  <div class="container">

    {# Логотип (десктоп ≥ md) — alt пустой, т.к. есть текст TodoList #}
    <a class="navbar-brand d-none d-md-flex align-items-center text-white text-shadow"
       href="{{ path('app_kanban') }}">
      <img
        src="{{ asset('images/logo.svg') }}"
        alt=""
        width="28" height="28"
        class="brand-logo me-2">
      TodoList
    </a>

    {# Мобайл: логотип + бургер #}
    <div class="d-flex d-md-none align-items-center w-100 justify-content-between">
      <a class="navbar-brand d-flex align-items-center text-white text-shadow"
         href="{{ path('app_kanban') }}">
        <img src="{{ asset('images/logo.svg') }}"
             width="28" height="28"
             class="brand-logo me-2"
             alt="">
        TodoList
      </a>

      <button class="navbar-toggler"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#mainNav"
              aria-controls="mainNav"
              aria-expanded="false"
              aria-label="Ouvrir le menu">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>

    <div id="mainNav" class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link text-focus"
             href="{{ path('app_task_index') }}"
             {# помечаем активную страницу #}
             {% if app.request.attributes.get('_route') in ['app_task_index'] %}aria-current="page"{% endif %}>
            Mes tâches
          </a>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto">
        <li class="nav-item d-flex align-items-center gap-2">
          <a class="nav-link text-focus d-inline-flex align-items-center"
             href="{{ path('app_profile') }}"
             {% if app.request.attributes.get('_route') starts with 'app_profile' %}aria-current="page"{% endif %}
             aria-label="Profil">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="22" height="22" viewBox="0 0 16 16"
                 fill="currentColor"
                 aria-hidden="true" focusable="false"
                 class="bi bi-person-check">
              <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.5.5 0 0 1 .708-.708l.547.548 1.17-1.951a.5.5 0 1 1 .858.514"/>
              <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
              <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
            </svg>
          </a>

          <form method="post" action="{{ path('app_logout') }}" class="m-0">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="btn btn-sm text-focus">Déconnexion</button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</nav>