{% extends 'base.html.twig' %}

{% block title %}{{ task.title ?? 'Task' }}{% endblock %}

{% block body %}
<div class="container py-4">

  {# Заголовок + кнопки (адаптивно, без изменения стилей) #}
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-md-between mb-3 gap-2">
    <h1 class="page-title m-0">Détail de la tâche</h1>

    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-outline-dark" href="{{ path('app_task_index') }}">← Retour</a>
      <a class="btn btn-outline-dark" href="{{ path('app_task_edit', {id: task.id}) }}">✏️ Modifier</a>
      {{ include('task/_delete_form.html.twig', {
        task: task,
        button_class: 'btn btn-action btn-delete',
        inner_html: '🗑'
      }) }}
    </div>
  </div>

  <div class="table-card bg-white shadow-sm p-0">

    {# ====== ДЕСКТОП/ПЛАНШЕТ (>= md): обычная таблица БЕЗ .table-responsive ====== #}
    <div class="d-none d-md-block">
      <table class="table align-middle mb-0">
        <tbody>
          <tr>
            <th style="width:200px">ID</th>
            <td class="text-muted">{{ task.id }}</td>
          </tr>
          <tr>
            <th>Titre</th>
            <td class="text-break">{{ task.title }}</td>
          </tr>
          <tr>
            <th>Statut</th>
            <td>
              {% set statusText = task.status ?? '' %}
              {% if statusText %}
                {% set st = statusText|lower %}
                {% set badgeClass =
                  st in ['à faire','a faire','todo','a_faire'] ? 'badge-todo' :
                  (st in ['en cours','doing','progress'] ? 'badge-doing' :
                  (st in ['terminé','termine','done'] ? 'badge-done' : 'badge-other')) %}
                <span class="badge status-badge {{ badgeClass }}">{{ task.status }}</span>
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
          </tr>
          <tr>
            <th>Description</th>
            <td class="text-muted text-break">{{ task.description }}</td>
          </tr>
        </tbody>
      </table>
    </div>

    {# ====== ТЕЛЕФОН (< md): компактный список ====== #}
    <div class="d-md-none p-3 vstack gap-3 small">
      <div>
        <div class="fw-bold mb-1">#</div>
        <div class="text-muted">{{ task.id }}</div>
      </div>

      <div>
        <div class="fw-bold mb-1">Titre</div>
        <div class="text-break">{{ task.title }}</div>
      </div>

      <div>
        <div class="fw-bold mb-1">Statut</div>
        <div>
          {% if statusText %}
            <span class="badge status-badge {{ badgeClass }}">{{ task.status }}</span>
          {% else %}
            <span class="text-muted">—</span>
          {% endif %}
        </div>
      </div>

      <div>
        <div class="fw-bold mb-1">Description</div>
        <div class="text-muted text-break">{{ task.description }}</div>
      </div>
    </div>

  </div>
</div>
{% endblock %}