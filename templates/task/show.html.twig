

{% extends 'base.html.twig' %}
{# Le template hérite de la structure générale du site (header, footer, etc.) #}
{% block title %}{{ task.title ?? 'Task' }}{% endblock %}
{# Si la tâche a un titre → on l'affiche ; sinon on affiche "Task".
   L'opérateur ?? permet d'éviter une erreur si la valeur est nulle. #}
{% block body %}
<div class="container py-4" role="main" aria-labelledby="page-title"> 
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-md-between mb-3 gap-2">
   {# Grâce aux classes Bootstrap :
       • flex-column → affichage en colonne sur mobile (vertical)
       • flex-md-row → affichage en ligne sur desktop/tablette (horizontal)
       Cela rend la page responsive automatiquement #}
    <h1 class="page-title m-0" id="page-title">Détail de la tâche</h1>

    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-secondary"
         href="{{ path('app_task_index') }}"
         aria-label="Retourner à la liste des tâches">← Retour</a> {# Bouton "Retour" vers la liste des tâches #}
      <a class="btn btn-warning"
         href="{{ path('app_task_edit', {id: task.id}) }}" {# Lien vers l’édition : on passe l’ID dans l’URL #}
         aria-label="Modifier la tâche"> Modifier</a>
    </div>
  </div>
 {# d-none d-md-block =
       • d-none → caché sur mobile
       • d-md-block → visible à partir de 768px #}
  <div class="table-card bg-white shadow-sm p-0 rounded-5 overflow-hidden">
    <div class="d-none d-md-block">
      <table class="table align-middle mb-0">
        <tbody>
          <tr>
            <th style="width:200px" scope="row">ID</th>
            <td class="text-muted">{{ task.id }}</td>
          </tr>
          <tr>
            <th scope="row">Titre</th>
            <td class="text-break">{{ task.title }}</td> {# text-break évite que les titres trop longs débordent du tableau #}
          </tr>
          <tr>
            <th scope="row">Statut</th>
            <td> {# On récupère la valeur du statut en sécurité (si null → '') #}
              {% set st = task.status ?? '' %}
              {# Selon le statut enregistré en base, on applique un badge couleur #}
              {% if st == 'todo' %}
                 {% set badgeClass = 'badge-todo' %}
              {% elseif st == 'doing' %}
                  {% set badgeClass = 'badge-doing' %}
              {% elseif st == 'done' %}
                  {% set badgeClass = 'badge-done' %}
              {% elseif st == 'urgent' %}
                  {% set badgeClass = 'badge-urgent' %}
              {% else %}
                  {% set badgeClass = 'badge-other' %}
              {% endif %}
            </td>
          </tr>
          <tr>
            <th scope="row">Description</th>
            <td class="text-muted text-break">{{ task.description }}</td>
          </tr>
        </tbody>
      </table>
    </div>
       {# d-md-none =  • visible uniquement en dessous de "md" (mobile)
        vstack = empile les éléments verticalement
       → affichage en colonne : idéal pour les petits écrans#}
   
    <div class="d-md-none p-3 vstack gap-3 small">
      <div>
        <div class="fw-bold mb-1">#</div>
        <div class="text-muted">{{ task.id }}</div>
      </div>

      <div>
        <div class="fw-bold mb-1">Titre</div>
        <div class="text-break">{{ task.title }}</div>
      </div>

      <div>
        <div class="fw-bold mb-1">Statut</div>
        <div>
          {% if st %}
            <span class="badge status-badge {{ badgeClass }}"
                  aria-label="Statut : {{ task.status }}">{{ task.status }}</span>
          {% else %}
            <span class="text-muted">—</span>
          {% endif %}
        </div>
      </div>

      <div>
        <div class="fw-bold mb-1">Description</div>
        <div class="text-muted text-break">{{ task.description }}</div>
      </div>
    </div>

  </div>
</div>
{% endblock %}