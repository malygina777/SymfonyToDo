

{{ form_start(form, {'attr': {'role': 'form'}}) }}

<div class="row g-3">
  <div class="col-12">
    {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label fw-bold'}}) }}
    {{ form_widget(form.title, {
      'attr': {
        'class': 'form-control',
        'placeholder': 'Entrez un titre',
        'autocomplete': 'off'
      }
    }) }}
    {{ form_errors(form.title) }}
  </div>

  <div class="col-12">
    {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-bold'}}) }}
    {{ form_widget(form.status, {
      'attr': {
        'class': 'form-select'
      }
    }) }}
    {{ form_errors(form.status) }}
  </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-3">
  <a href="{{ path('app_task_index') }}" class="btn btn-outline-secondary" aria-label="Retour à la liste">
    ← Retour
  </a>
  <button class="btn btn-outline-primary" type="submit">
    Enregistrer
  </button>
</div>

{{ form_end(form) }}