

{% extends 'base.html.twig' %}

{% block title %}Créer une tâche{% endblock %}

{% block body %}
<div class="container py-4" role="main" aria-labelledby="page-title">

  {# открываем форму здесь, чтобы submit-кнопка была в верхнем хедере #}
  {{ form_start(form, {'attr': {'role': 'form', 'aria-label': 'Formulaire de création de tâche'}}) }}

  {# Хедер страницы + действия справа (как в Show/Edit) #}
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between mb-3 gap-3">
    <div>
      <h1 id="page-title" class="page-title m-0">Créer une tâche</h1>
      <div class="page-subtitle" id="page-subtitle">Renseignez les informations de votre tâche</div>
    </div>

    <div class="d-flex justify-content-between gap-2" role="group" aria-label="Actions de la page">
      <a href="{{ path('app_task_index') }}" 
         class="btn btn-secondary" 
         role="button"
         aria-label="Retourner à la liste des tâches">← Retour</a>

      <button type="submit" 
              class="btn btn-success" 
              aria-label="Enregistrer cette tâche">
        Enregistrer
      </button>
    </div>
  </div>

  {# Карточка с полями формы, центрируем и даём внутренние отступы #}
  <div class="table-card bg-white shadow-sm mx-auto rounded-5 overflow-hidden" 
       role="region" 
       aria-labelledby="page-subtitle">
    <div class="p-3">

      <div class="mb-3">
        {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label fw-bold', 'for': form.title.vars.id}}) }}
        {{ form_widget(form.title, {
          'attr': {
            'class': 'form-control',
            'placeholder': 'Entrez un titre',
            'aria-required': 'true',
            'aria-describedby': form.title.vars.id ~ '_help'
          }
        }) }}
        <small id="{{ form.title.vars.id }}_help" class="form-text text-muted visually-hidden">
          Indiquez le titre de votre tâche.
        </small>
      </div>

      <div class="mb-3">
        {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-bold', 'for': form.status.vars.id}}) }}
        {{ form_widget(form.status, {
          'attr': {
            'class': 'form-select',
            'aria-required': 'true',
            'aria-describedby': form.status.vars.id ~ '_help'
          }
        }) }}
        <small id="{{ form.status.vars.id }}_help" class="form-text text-muted visually-hidden">
          Choisissez le statut actuel de votre tâche.
        </small>
      </div>

      <div class="mb-3">
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold', 'for': form.description.vars.id}}) }}
        {{ form_widget(form.description, {
          'attr': {
            'class': 'form-control',
            'aria-describedby': form.description.vars.id ~ '_help'
          }
        }) }}
        <small id="{{ form.description.vars.id }}_help" class="form-text text-muted visually-hidden">
          Ajoutez une brève description ou des détails.
        </small>
      </div>

      <div class="mb-3">
        {{ form_label(form.dueAt, 'Date à laquelle vous souhaitez être alerté', {'label_attr': {'class': 'form-label fw-bold', 'for': form.dueAt.vars.id}}) }}
        {{ form_widget(form.dueAt, {
          'attr': {
            'class': 'form-control',
            'aria-describedby': form.dueAt.vars.id ~ '_help'
          }
        }) }}
        <small id="{{ form.dueAt.vars.id }}_help" class="form-text text-muted visually-hidden">
          Sélectionnez la date limite ou la date d’alerte.
        </small>
      </div>

    </div>
  </div>

  {{ form_end(form) }}
</div>
{% endblock %}