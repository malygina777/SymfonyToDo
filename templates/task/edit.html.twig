


{% extends 'base.html.twig' %}
{% block title %}Modifier la tâche{% endblock %}

{% block body %}
<div class="container py-4" role="main">

  {# Заголовок + экшен-кнопки справа #}
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h1 class="page-title m-0" id="edit-task-title">Modifier la tâche</h1>
    </div>

    <div class="d-flex align-items-center gap-2" role="group" aria-label="Actions de la tâche">
      <a class="btn btn-secondary " href="{{ path('app_task_index') }}" aria-label="Retour à la liste des tâches">⟵ Retour</a>
      <button form="form-task" type="submit" class="btn btn-success " aria-label="Enregistrer la tâche">
        ✓ Enregistrer
      </button>
      {{ include('task/_delete_form.html.twig') }}
    </div>
  </div>

  {# Карточка с формой #}
  <div class="table-card bg-white shadow-sm p-4 rounded-5 overflow-hidden" aria-labelledby="edit-task-title">
    {{ form_start(form, { attr: { id: 'form-task', role: 'form', 'aria-describedby': 'form-help' } }) }}

      <div class="mb-3">
        {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label fw-bold', 'for': 'title-field'}}) }}
        {{ form_widget(form.title, {
          'attr': {
            'class': 'form-control',
            'id': 'title-field',
            'placeholder': 'Entrez un titre',
            'aria-required': 'true'
          }
        }) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-bold', 'for': 'status-field'}}) }}
        {{ form_widget(form.status, {
          'attr': {
            'class': 'form-select',
            'id': 'status-field',
            'aria-required': 'true'
          }
        }) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold', 'for': 'desc-field'}}) }}
        {{ form_widget(form.description, {
          'attr': {
            'class': 'form-control',
            'id': 'desc-field',
            'aria-describedby': 'desc-help'
          }
        }) }}
        <div id="desc-help" class="form-text">Ajoutez ici les détails de votre tâche.</div>
      </div>

      <div class="mb-3">
        {{ form_label(form.dueAt, 'Date à laquelle vous souhaitez être alerté', {'label_attr': {'class': 'form-label fw-bold', 'for': 'date-field'}}) }}
        {{ form_widget(form.dueAt, {
          'attr': {
            'class': 'form-control',
            'id': 'date-field',
            'aria-label': 'Choisir la date d’alerte'
          }
        }) }}
      </div>

    {{ form_end(form) }}
  </div>

</div>
{% endblock %}