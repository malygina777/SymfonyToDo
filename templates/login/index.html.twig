

{% extends 'base.html.twig' %}
{% block layout_header %}{% endblock %}
{% block layout_footer %}{% endblock %}

{% block title %}Connexion{% endblock %}

{% block body %}

<a href="#main-content" class="visually-hidden-focusable">Aller au contenu principal</a>

<div class="page-bg-login">
  <div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-8 col-lg-5">

      <main id="main-content" class="card card-glass border-0 shadow rounded-4" role="main">
        <div class="card-header bg-kanban-footer text-primary-emphasis text-center rounded-top-4">
          <h1 class="h3 fw-bold mb-1">Connexion</h1>
        </div>

        <div class="card-body p-4">

          {# Flash messages (succès / info) — объявляем как "polite" #}
          {% for label, messages in app.flashes %}
            {% for message in messages %}
              <div class="alert alert-{{ label }} alert-dismissible fade show"
                   role="status" aria-live="polite">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
              </div>
            {% endfor %}
          {% endfor %}

          {# Сообщение об ошибке аутентификации — объявляем как "assertive" #}
          {% set loginErrorId = 'login-error' %}
          {% if error %}
            <div id="{{ loginErrorId }}" class="alert alert-danger small mb-3"
                 role="alert" aria-live="assertive">
              {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
          {% endif %}

          <form method="post" action="{{ path('app_login') }}" {% if not error %}novalidate{% endif %} aria-describedby="{% if error %}{{ loginErrorId }}{% endif %}">
            <div class="mb-3">
              <label for="inputEmail" class=" fw-semibold form-label small text-muted">E-mail</label>
              <input
                type="email"
                id="inputEmail"
                name="email"
                class="form-control"
                value="{{ last_username }}"
                autocomplete="username"        {# рекомендовано для логина, даже если это e-mail #}
                inputmode="email"              {# удобная клавиатура на мобилках #}
                required
                {% if error %}aria-invalid="true"{% endif %}
                aria-describedby="email-help{% if error %} {{ loginErrorId }}{% endif %}"
                autofocus
              >
             
            </div>
              

            <div class="mb-3">
              <label for="inputPassword" class=" fw-semibold form-label small text-muted">Mot de passe</label>
              <input
                type="password"
                id="inputPassword"
                name="password"
                class="form-control"
                autocomplete="current-password"
                required
                {% if error %}aria-invalid="true"{% endif %}
                aria-describedby="password-help{% if error %} {{ loginErrorId }}{% endif %}"
              >
            </div>

            {# CSRF для form_login ( data-controller="csrf-protection" )#}
            <input type="hidden" name="_csrf_token"  data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="d-flex align-items-center justify-content-between mt-4">
              <button class="btn btn-create px-4" type="submit">Se connecter</button>
              <small class="text-muted">
                Pas de compte ?
                <a class="text-primary text-decoration-none" href="{{ path('app_registration') }}">Inscription</a>
              </small>
            </div>

            <p class="mt-3 text-end">
              <a href="{{ path('app_forgot_password_request') }}" class="text-primary text-decoration-none">
                Réinitialiser le mot de passe
              </a>
            </p>
          </form>

        </div>
      </main>


</div>
  </div>
</div>
{% endblock %}