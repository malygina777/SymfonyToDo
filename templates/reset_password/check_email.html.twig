
{% extends 'base.html.twig' %}
{% block layout_header %}{% endblock %}
{% block layout_footer %}{% endblock %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block body %}

{# Skip-link: быстрый переход к основному содержанию #}
<a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>

<div class="page-bg-check">
  <div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-8 col-lg-5">
      <div class="card card-glass border-0 shadow rounded-4">

        <div class="card-header bg-kanban-footer text-primary-emphasis text-center rounded-top-4">
          <h1 id="page-title" class="h3 fw-bold mb-1">Password Reset Email Sent</h1>
        </div>

        {# Основной контент страницы (landmark) #}
        <main id="main-content" class="card-body p-4 p-md-5 text-center" role="main" aria-labelledby="page-title" tabindex="-1">
          <p class="mb-3">
            If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
          </p>

          <p class="mb-3">
            This link will expire in
            <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
          </p>

          <p class="mb-0">
            If you don't receive an email, please check your spam folder
            or
            <a class="link-warning text-decoration-none fw-bold" href="{{ path('app_forgot_password_request') }}">
              try again
            </a>.
          </p>
        </main>

      </div>
    </div>
  </div>
</div>
{% endblock %}