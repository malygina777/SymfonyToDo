
{% extends 'base.html.twig' %}
{% block layout_header %}{% endblock %}
{% block layout_footer %}{% endblock %}

{% block title %}Reset your password{% endblock %}

{% block body %}

{# Skip link — переход к контенту с клавиатуры #}
<a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>

<div class="page-bg-request">
  <div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-8 col-lg-5">
      <main id="main-content" class="card card-glass border-0 shadow rounded-4" role="main" aria-labelledby="page-title">

        {# Flash-сообщение об ошибке — озвучивается скринридером #}
        {% for flash_error in app.flashes('reset_password_error') %}
          <div class="alert alert-danger m-3 mb-0" role="alert" aria-live="assertive">{{ flash_error }}</div>
        {% endfor %}

        <div class="card-header bg-kanban-footer text-primary-emphasis text-center rounded-top-4">
          <h1 id="page-title" class="h3 fw-bold mb-1">Reset your password</h1>
        </div>

        <div class="card-body p-4 p-md-5">

          {{ form_start(requestForm) }}

            {# Метка для поля email (label связан с input автоматически) #}
            {{ form_label(requestForm.email, 'E-mail', {
              label_attr: { class: 'form-label small text-muted' }
            }) }}

            {# Поле ввода email с базовыми атрибутами доступности #}
            {{ form_widget(requestForm.email, {
              attr: {
                id: 'inputEmail',
                class: 'form-control',
                autocomplete: 'email',
                inputmode: 'email',
                'aria-describedby': 'email-help'
              }
            }) }}

            {{ form_errors(requestForm.email) }}

            {# Подсказка к полю #}
            <div id="email-help" class="form-text mb-4">
              Enter your email address, and we will send you a link to reset your password.
            </div>

            {# Кнопки #}
            <div class="d-flex align-items-center justify-content-between mt-4 gap-4">
              <a href="{{ path('app_login') }}" class="btn btn-secondary text-shadow text-decoration-none" aria-label="Back to login page">
                &#8592; Back
              </a>
              <button type="submit" class="btn btn-create px-4">
                Send password reset email
              </button>
            </div>

          {{ form_end(requestForm) }}
        </div>

      </main>
    </div>
  </div>
</div>
{% endblock %}