

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" dir="ltr">
  <head>
    {# SEO: autoriser uniquement la page d’accueil à être indexée #}
    {% if app.request.attributes.get('_route') == 'app_home' %}
     <meta name="robots" content="index, follow">
     <meta name="description" content="Application Kanban pour organiser vos tâches facilement : créer, déplacer et suivre vos projets.">
     <meta name="keywords" content="Kanban, Symfony, gestion de tâches, application web, productivité">
     <link rel="canonical" href="{{ absolute_url(path('app_home')) }}">
    {% else %}
          <meta name="robots" content="noindex, nofollow">
    {% endif %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Mon application{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/kanban.css') }}">

    {% block javascripts %}
      {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>


  <body data-turbo="false">
    
    <a class="visually-hidden-focusable" href="#main-content">Aller au contenu</a>

    <div class="bg-kanban">
      {% block layout_header %}

        {% include "nav/_nav.html.twig" %}
      {% endblock %}

      <main id="main-content" class="main-content" role="main" aria-live="polite">
        {% block body %}{% endblock %}
      </main>

      {% block layout_footer %}
       
        {% include "footer/_footer.html.twig" %}
      {% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>



