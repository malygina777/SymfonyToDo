
{% extends 'base.html.twig' %}

{% block title %}Kanban Board{% endblock %}

{% block body %}


<div class="container py-4">

  <meta name="csrf-kanban" content="{{ csrf_token('kanban_order') }}">

  {% set LABELS = {
    'urgent': 'Urgent',
    'todo':   'A faire',
    'doing':  'En cours',
    'done':   'Terminé'
  } %}

  {% set HEADER_CLASS = {
    'todo':   'bg-primary text-white',
    'doing':  'bg-warning text-dark',
    'done':   'bg-success text-white',
    'urgent': 'bg-danger text-white'
  } %}

  {% set DOT_COLOR = {
    'todo':   'bg-primary',
    'doing':  'bg-warning',
    'done':   'bg-success',
    'urgent': 'bg-danger'
  } %}

  <section class="kanban kanban-glass shadow-lg rounded-4 p-3 p-md-2"
           role="region" aria-label=" Tableau principal à quatre colonnes et des tâches à l'intérieur">

    <div class="row flex-nowrap  g-3 overflow-auto kanban-columns">

      {% for key in ['urgent','todo','doing','done'] %}
        {% set items = columns[key] ?? [] %}

        <div class="col-10 col-sm-8 col-md-6 col-lg-3">
          <div class="kanban-column h-100 rounded-3 overflow-hidden"
               role="region"
               aria-labelledby="col-title-{{ key }}">

            <div class="kanban-column-header d-flex align-items-center justify-content-between {{ HEADER_CLASS[key] }} px-3 py-2">
              <span class="fw-semibold text-uppercase text-white small"
                    id="col-title-{{ key }}">{{ LABELS[key] }}</span>

              <span id="count-{{ key }}"
                    class="badge text-bg-light text-dark"
                    aria-live="polite" aria-atomic="true">{{ items|length }}</span>
            </div>

            <div class="kanban-cards p-2" id="col-{{ key }}"
                 role="list" aria-label="Cartes : {{ LABELS[key] }}">
              {% for task in items %}
                <div class="card kanban-card mb-2 shadow-sm border-0"
                     data-id="{{ task.id }}"
                     role="listitem"
                     tabindex="0"
                     aria-label="Tâche #{{ task.id }} — {{ task.title }}">
                  <div class="card-body p-2">
                    <div class="d-flex align-items-start justify-content-between">
                      <div>
                        <div class="kanban-meta small text-muted">#{{ task.id }}</div>
                        <div class="small fw-semibold  text-break">{{ task.title }}</div>
                      </div>
                      <span class="dot {{ DOT_COLOR[key] }}" aria-hidden="true"></span>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="text-muted small px-2"></div>
              {% endfor %}
            </div>
          </div>
        </div>

      {% endfor %}
    </div>

  </section>
</div>



<script>
document.addEventListener('DOMContentLoaded', () => {         // 1. On attend que le DOM soit construit (les nœuds sont disponibles).
  const columns = document.querySelectorAll('.kanban-cards'); // 2. On récupère tous les conteneurs-colonnes avec la classe .kanban-cards.
  let dragged = null;                                         //  3. Variable qui contient la carte actuellement déplacée.
  
    // correspondance entre colonnes et classes de couleur.
  const DOT_BY_COL = { todo:'bg-primary', doing:'bg-warning', done:'bg-success', urgent:'bg-danger' };
  
  //  recolorer le point d’une carte en fonction de sa colonne
  function applyDotColor(task, colKey) {
    const dot = task.querySelector('.dot');
    if (!dot) return;
    dot.classList.remove('bg-primary', 'bg-warning', 'bg-success', 'bg-danger');
    dot.classList.add(DOT_BY_COL[colKey] || 'bg-secondary');
  }


  // Rendre les cartes déplaçables
  function bindDraggableCards() {                                 // 4. Fonction qui attache les écouteurs à toutes les cartes.
    document.querySelectorAll('.kanban-card').forEach(card => {   // 5. On sélectionne tous les éléments avec la classe .kanban-card.
      
      card.setAttribute('draggable', 'true');                     // ajout un atribu

      card.addEventListener('dragstart', (e) => {                 // 6. Événement au début du déplacement.
        dragged = card;                                           // 7. On mémorise quelle carte est déplacée.
        card.classList.add('dragging');                           // 8. On ajoute une classe visuelle (.dragging).
        e.dataTransfer.setData('text/plain', card.dataset.id);    // 9. On met l’ID de la carte dans le “bagage” DnD pour compatibilité.
      });

      card.addEventListener('dragend', () => {                    // 10. Événement à la fin du déplacement.
        dragged?.classList.remove('dragging');                    // 11. On enlève la classe visuelle .dragging.
        dragged = null;                                           // 12. On nettoie la variable : aucune carte n’est en cours de déplacement.
      });
    });
  }
  bindDraggableCards();                                           // 13. On applique immédiatement les écouteurs à toutes les cartes.

  // 2.Colonnes qui acceptent le drop
  columns.forEach(col => {                                        // 14) Pour chaque colonne...
    col.addEventListener('dragover', (e) => {                     // 15) Événement quand on survole la colonne avec une carte.
      e.preventDefault();                                         // 16) OBLIGATOIRE : autoriser le drop, sinon l’événement drop ne se déclenche pas.
      if (!dragged) return;                                       // 17)  Si aucune carte n’est déplacée, on ne fait rien.
      col.appendChild(dragged);                                   // 18) On place la carte à la fin de cette colonne.
    });

        // A)Fonction de recalcul des compteurs.
       function updateCounters() {
      ['todo','doing','done','urgent'].forEach(k => {
        const box = document.getElementById('col-' + k);
        const badge = document.getElementById('count-' + k);
        if (!box || !badge) return;                        
        badge.textContent = box.querySelectorAll('.kanban-card').length;
      });
   }
      // B) Premier calcul des compteurs au chargement.
      updateCounters();

    col.addEventListener('drop', (e) => {
    e.preventDefault();
    e.stopPropagation();
    
    const colKey = (col.id || '').replace('col-', '');                              // 'todo' | 'doing' | 'done' | 'urgent'  On récupère la clé de la colonne à partir de son id.
    if (dragged) applyDotColor(dragged, colKey);                                    // On recolore le point de la carte déposée.
    updateCounters();                                                               // nous recalculons le nombre de taches dans la colonne
    
    saveOrder();                                                                     // On sauvegarde l’ordre.
  });
  });
                                                                                    
  // 3. Sauvegarde de l’ordre
  function saveOrder() {                                          // 21)On envoie au serveur le nouvel ordre des cartes
    const csrf = document.querySelector('meta[name="csrf-kanban"]')?.content || '';
                                                                  // 22) On lit le jeton CSRF dans la balise <meta>.
    const data = {                                                // 23) On construit l’objet de données.
      _token: csrf,                                               //     — кладём токен под ключом _token (как ждёт контроллер).
      todo:   Array.from(document.querySelectorAll('#col-todo .kanban-card'))
               .map(c => c.dataset.id),                           // 24)  On collecte la liste des IDs de la colonne todo.
      doing:  Array.from(document.querySelectorAll('#col-doing .kanban-card'))
               .map(c => c.dataset.id),                           // 25) Pareil pour la colonne doing.
      done:   Array.from(document.querySelectorAll('#col-done .kanban-card'))
               .map(c => c.dataset.id),                           // 26) Pareil pour done
      urgent: Array.from(document.querySelectorAll('#col-urgent .kanban-card'))
               .map(c => c.dataset.id),                           // 27)  Pareil pour urgent.
    };


    fetch('/kanban/save-order', {                                 // 28) On envoie une requête POST vers la route de sauvegarde.
      method: 'POST',                                             // 29) Méthode HTTP : POST.
      headers: { 'Content-Type': 'application/json' },            // 30) On indique au serveur qu’on envoie du JSON.
      body: JSON.stringify(data)                                  // 31) On convertit l’objet data en JSON.
    });                                                           // 32) On n’analyse pas la réponse ici (optionnel .then()).
  }
});
</script>

{% endblock %}
